<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="FileTray.App"
             xmlns:local="using:FileTray"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <!-- 展开态的 thumb 缩放:与缩小态一致(细条),避免展开动画 -->
        <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.125) translateY(-2px)</TransformOperations>
        <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.125) translateX(-2px)</TransformOperations>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- 滚动条永远保持缩小状态:覆盖 Fluent 主题的展开态样式
             (IsExpanded=true 时轨道/箭头/全尺寸 thumb 都压回缩小态视觉) -->
        <Style Selector="ScrollBar[IsExpanded=true] /template/ Grid#Root">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar[IsExpanded=true] /template/ Rectangle#TrackRect">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ScrollBar[IsExpanded=true] /template/ Thumb">
            <Setter Property="RenderTransform" Value="{DynamicResource HorizontalSmallScrollThumbScaleTransform}" />
        </Style>
        <Style Selector="ScrollBar[IsExpanded=true]:horizontal /template/ Thumb">
            <Setter Property="RenderTransform" Value="{DynamicResource HorizontalSmallScrollThumbScaleTransform}" />
        </Style>
        <Style Selector="ScrollBar[IsExpanded=true]:vertical /template/ Thumb">
            <Setter Property="RenderTransform" Value="{DynamicResource VerticalSmallScrollThumbScaleTransform}" />
        </Style>
        <Style Selector="ScrollBar[IsExpanded=true] /template/ RepeatButton">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- 成员筛选按钮的选中态:高亮(通过样式类 memberSelected 标记) -->
        <Style Selector="Button.memberSelected">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Application.Styles>
</Application>
